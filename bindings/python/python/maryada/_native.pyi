    @staticmethod
    def empty() -> Interval: ...
    @staticmethod
    def entire() -> Interval: ...
    @staticmethod
    def parse(text: str) -> Interval: ...
    @staticmethod
    def parse_checked(text: str) -> tuple[Interval, bool]: ...
    @staticmethod
    def from_bytes(data: bytes, byteorder: _ByteOrder = "big") -> Interval: ...
    @staticmethod
